APP_NAME=STEMLY
APP_ENV=local
APP_KEY=base64:PWlF9rnWnLPEVHHR6PQtebFT1CHg4NdZw87hNWRD+BM=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
